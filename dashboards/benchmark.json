{
  "uid": "group3-evidence",
  "title": "Group 3 benchmark evidence",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "1s",
  "tags": [
    "group3",
    "evidence"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "jobs",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up, job)",
        "multi": true,
        "includeAll": false
      },
      {
        "name": "run_id",
        "type": "textbox",
        "query": "NOT_RUN"
      },
      {
        "name": "variant",
        "type": "textbox",
        "query": "NOT_RUN"
      },
      {
        "name": "workload",
        "type": "textbox",
        "query": "NOT_RUN"
      },
      {
        "name": "evidence_status",
        "type": "textbox",
        "query": "NOT_RUN"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Evidence context (select the matching SUT jobs)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Run: **${run_id}** \u00b7 Variant: **${variant}** \u00b7 Workload: **${workload}** \u00b7 Evidence: **${evidence_status}**\n\nContext is supplied by the operator; select only this run's SUT scrape jobs. Missing series mean missing evidence. Offline artifacts are authoritative for cohorts and exact quantiles."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Offered / admitted / active Gold (measurement only)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(benchmark_planned_total{job=~\"$jobs\",phase=\"measurement\"}[$__rate_interval])",
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "expr": "rate(benchmark_admitted_total{job=~\"$jobs\",phase=\"measurement\"}[$__rate_interval])",
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "expr": "rate(benchmark_gold_visible_total{job=~\"$jobs\",phase=\"measurement\"}[$__rate_interval])",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency p50/p95/p99 (histogram estimates)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,service,route) (rate(request_duration_seconds_bucket{job=~\"$jobs\"}[$__rate_interval])))",
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,service,route) (rate(request_duration_seconds_bucket{job=~\"$jobs\"}[$__rate_interval])))",
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le,service,route) (rate(request_duration_seconds_bucket{job=~\"$jobs\"}[$__rate_interval])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka lag by group/topic/partition",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_lag{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pending Gold publication (independent of Kafka commits)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gold_pending_events{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox pending by service",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_pending{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Oldest outbox row age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_oldest_age_seconds{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Quarantine by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(quarantine_total{job=~\"$jobs\"}[$__rate_interval])",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Projection age and apply outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "projection_age_seconds{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Saga states and reservation race rejections",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "saga_orders{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "expr": "increase(reservation_race_rejections_total{job=~\"$jobs\"}[$__rate_interval])",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU cores used (allocation recorded in artifacts)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"$jobs\"}[$__rate_interval])",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Process RSS (sampled separately per job/instance)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Scrape availability and collector health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "expr": "benchmark_observation_up{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "expr": "absent(up{job=~\"$jobs\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Active Gold generation",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gold_generation{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Stock audit totals (approved read-only projection)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_inventory_units{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Generator pending queue (bounded active + queued)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_pending_records{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "expr": "benchmark_pending_bytes{job=~\"$jobs\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Fixed workflow model attempts (required zero)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(intent_llm_calls_total{job=~\"$jobs\"}[$__rate_interval])",
          "legendFormat": "__auto"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  }
}
