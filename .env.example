# ==============================================================================
# Group 3 - Payment Gateway / E-Commerce Platform Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as necessary for local development.
# Do NOT commit real credentials or actual secrets to version control.
# Reference: docs/specs/02_COMMON_SPEC.md §2
# ==============================================================================

# Run and Namespace Identity
RUN_NAMESPACE=local-dev
RUN_ID=00000000-0000-4000-8000-000000000000

# PostgreSQL Service Databases (Isolated credentials per service)
# Default port 5432 on localhost or postgres in Compose
CONVERSATION_DATABASE_URL=postgresql://conversation_user:conversation_pass@localhost:5432/conversation_db
CATALOG_DATABASE_URL=postgresql://catalog_user:catalog_pass@localhost:5432/catalog_db
ORDERS_DATABASE_URL=postgresql://orders_user:orders_pass@localhost:5432/orders_db
INVENTORY_DATABASE_URL=postgresql://inventory_user:inventory_pass@localhost:5432/inventory_db
PAYMENTS_DATABASE_URL=postgresql://payments_user:payments_pass@localhost:5432/payments_db
ANALYTICS_DATABASE_URL=postgresql://analytics_user:analytics_pass@localhost:5432/analytics_db

# Kafka and Schema Registry
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Internal HTTP Service Endpoints (Local development / Compose ports)
CONVERSATION_BASE_URL=http://localhost:8001
CATALOG_BASE_URL=http://localhost:8002
ORDERS_BASE_URL=http://localhost:8003
INVENTORY_BASE_URL=http://localhost:8004
PAYMENTS_BASE_URL=http://localhost:8005
ANALYTICS_BASE_URL=http://localhost:8006

# Internal Service Authentication & Timers
INTERNAL_API_TOKEN=placeholder-internal-token-change-locally
OUTBOX_POLL_MS=25
SINK_BATCH_MAX_ROWS=1
SINK_BATCH_MAX_WAIT_MS=50
GOLD_PUBLISH_INTERVAL_MS=250
RESERVATION_TTL_SECONDS=30
QUOTE_TTL_SECONDS=60

# Data Roots and Catalogue Ingestion
DATA_ROOT=./data
CATALOG_SOURCE_PATH=./data/raw/flipkart_com-ecommerce_sample.csv
CATALOG_RULES_VERSION=flipkart-v1
CATALOG_DATASET_REVISION=rev-2026-10-24
CATALOG_LOAD_MODE=copy

# Retrieval and Model Configurations
MODEL_REVISION=v1.0
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
SEARCH_DEFAULT_MODE=lexical
ASSISTANT_MODE=fixed
ALLOW_INTENT_LLM=false
INTENT_LLM_TIMEOUT_MS=1500
# Optional P11 only: supply a reviewed dated model snapshot and key privately.
# There is no implicit model, live evaluation, SDK retry or generated response.
INTENT_LLM_MODEL=
OPENAI_API_KEY=

# Benchmark and Testing Controls (false outside isolated tests)
BENCHMARK_MODE=false
FAULT_INJECTION_ENABLED=false
