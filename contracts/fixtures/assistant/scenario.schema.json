{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P3 automated-adjudication fixture envelope (test-only)",
  "type": "object",
  "required": ["fixture_version", "review_status", "frozen", "automated_llm_judge_review", "human_label_review", "quality_evaluation", "test_catalogue", "test_catalogue_sha256", "scenarios"],
  "properties": {
    "fixture_version": {"const": "assistant-adjudicated-v2"},
    "review_status": {"const": "awaiting_human_review"},
    "frozen": {"const": false},
    "automated_llm_judge_review": {"const": "COMPLETE"},
    "human_label_review": {"const": "PENDING_NOT_PERFORMED"},
    "quality_evaluation": {"const": "NOT_RUN"},
    "test_catalogue": {
      "type": "object",
      "required": ["synthetic", "test_mode", "real_catalogue_claim", "dictionary", "products"],
      "properties": {
        "synthetic": {"const": true},
        "test_mode": {"const": "explicit_fixture"},
        "real_catalogue_claim": {"const": false},
        "dictionary": {"type": "object"},
        "products": {"type": "array"}
      }
    },
    "test_catalogue_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scenarios": {
      "type": "array", "minItems": 60, "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["scenario_id", "text", "synthetic", "review_status", "reviewer", "reviewed_at", "intent_labels", "optional_labels", "catalogue_binding", "relevance_labels", "expected_outcome", "expected_behavior", "unresolved_constraints", "generative_call_budget"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^A-0[0-6][0-9]$"},
          "text": {"type": "string", "minLength": 1},
          "synthetic": {"const": true},
          "review_status": {"const": "awaiting_human_review"},
          "reviewer": {"type": "null"},
          "reviewed_at": {"type": "null"},
          "catalogue_binding": {"type": "null"},
          "relevance_labels": {"type": "null"},
          "intent_labels": {"$ref": "#/$defs/slots"},
          "optional_labels": {
            "type": "object", "required": ["brand", "category_path_prefix"], "additionalProperties": false,
            "properties": {"brand": {"type": "null"}, "category_path_prefix": {"type": "null"}}
          },
          "expected_outcome": {"type": "string", "minLength": 1},
          "expected_behavior": {
            "type": "object",
            "required": ["search_allowed", "search_call_count", "preserve_explicit_constraints", "never_invent_products_or_attributes", "purchase_requires_explicit_control_and_bound_confirmation"],
            "properties": {
              "search_allowed": {"type": "boolean"},
              "search_call_count": {"type": "integer", "minimum": 0, "maximum": 1},
              "preserve_explicit_constraints": {"const": true},
              "never_invent_products_or_attributes": {"const": true},
              "purchase_requires_explicit_control_and_bound_confirmation": {"const": true}
            }
          },
          "unresolved_constraints": {
            "type": "array", "items": {
              "type": "object", "required": ["slot", "raw_value", "reason"], "additionalProperties": false,
              "properties": {"slot": {"const": "size"}, "raw_value": {"type": "string"}, "reason": {"type": "string"}}
            }
          },
          "generative_call_budget": {
            "type": "object", "required": ["fixed", "assist"], "additionalProperties": false,
            "properties": {"fixed": {"const": 0}, "assist": {"enum": [0, 1]}}
          }
        }
      }
    }
  },
  "$defs": {
    "slots": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "size", "colour", "material", "max_price_minor", "occasion"],
      "properties": {
        "category": {"enum": [null, "clothing", "furniture"]},
        "size": {"enum": [null, "XXS", "XS", "S", "M", "L", "XL", "XXL", "XXXL", "FREE_SIZE", "ONE_SIZE"]},
        "colour": {"type": ["string", "null"]},
        "material": {"type": ["string", "null"]},
        "max_price_minor": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
        "occasion": {"type": ["string", "null"]}
      },
      "if": {"properties": {"size": {"type": "string"}}},
      "then": {"properties": {"category": {"const": "clothing"}}}
    }
  }
}
