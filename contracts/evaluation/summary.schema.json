{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "sample_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "MEASURED"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "sample_count": {
                "minimum": 1
              },
              "evidence_path": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "cohort": {
          "enum": [
            "measurement",
            "finite_job",
            "query"
          ],
          "title": "Cohort",
          "type": "string"
        },
        "quantile_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantile Method"
        },
        "unresolved_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unresolved Count"
        },
        "timing_validity": {
          "enum": [
            "NOT_RUN",
            "VALID",
            "MISSING",
            "RECOVERY_UPPER_BOUND"
          ],
          "title": "Timing Validity",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Run Id",
          "type": "string"
        },
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Config Sha256"
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "INCOMPLETE",
            "MEASURED"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Path"
        }
      },
      "required": [
        "name",
        "unit",
        "value",
        "sample_count",
        "numerator",
        "denominator",
        "cohort",
        "quantile_method",
        "unresolved_count",
        "timing_validity",
        "run_id",
        "config_sha256",
        "status",
        "evidence_path"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "namespace": {
      "pattern": "^[a-z][a-z0-9-]{0,61}$",
      "title": "Namespace",
      "type": "string"
    },
    "command": {
      "title": "Command",
      "type": "string"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "INCOMPLETE",
        "MEASURED"
      ],
      "title": "Status",
      "type": "string"
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3,
        4,
        5
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "test_mode": {
      "enum": [
        "offline",
        "stub",
        "real"
      ],
      "title": "Test Mode",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "config_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Config Sha256"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "namespace",
    "command",
    "status",
    "exit_code",
    "test_mode",
    "reasons",
    "metrics",
    "artifact_refs",
    "config_sha256"
  ],
  "title": "Summary",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:group3:evaluation:summary:1"
}
