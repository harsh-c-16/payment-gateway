      "title": "Source Hash",
      "type": "string"
    },
    "dataset_revision": {
      "title": "Dataset Revision",
      "type": "string"
    },
    "raw_rows": {
      "minimum": 0,
      "title": "Raw Rows",
      "type": "integer"
    },
    "canonical_rows": {
      "minimum": 0,
      "title": "Canonical Rows",
      "type": "integer"
    },
    "active_rows": {
      "minimum": 0,
      "title": "Active Rows",
      "type": "integer"
    },
    "inactive_rows": {
      "minimum": 0,
      "title": "Inactive Rows",
      "type": "integer"
    },
    "superseded_rows": {
      "minimum": 0,
      "title": "Superseded Rows",
      "type": "integer"
    },
    "rejected_rows": {
      "minimum": 0,
      "title": "Rejected Rows",
      "type": "integer"
    },
    "issue_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Issue Counts",
      "type": "object"
    },
    "inserted": {
      "minimum": 0,
      "title": "Inserted",
      "type": "integer"
    },
    "updated": {
      "minimum": 0,
      "title": "Updated",
      "type": "integer"
    },
    "unchanged": {
      "minimum": 0,
      "title": "Unchanged",
      "type": "integer"
    },
    "load_mode": {
      "enum": [
        "row",
        "copy"
      ],
      "title": "Load Mode",
      "type": "string"
    },
    "chunk_count": {
      "minimum": 0,
      "title": "Chunk Count",
      "type": "integer"
    },
    "chunks_resumed": {
      "default": 0,
      "minimum": 0,
      "title": "Chunks Resumed",
      "type": "integer"
