  "required": [
    "import_id",
    "source_hash",
    "dataset_revision",
    "raw_rows",
    "canonical_rows",
    "active_rows",
    "inactive_rows",
    "superseded_rows",
    "rejected_rows",
    "issue_counts",
    "inserted",
    "updated",
    "unchanged",
    "load_mode",
    "chunk_count",
