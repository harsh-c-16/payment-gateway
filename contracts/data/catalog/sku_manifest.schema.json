{
  "$defs": {
    "SkuEntry": {
      "additionalProperties": false,
      "properties": {
        "sku": {
          "pattern": "^[!-~]{1,64}$",
          "title": "Sku",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[!-~]{1,64}$",
          "title": "Product Id",
          "type": "string"
        },
        "source_pid": {
          "title": "Source Pid",
          "type": "string"
        },
        "source_observation_id": {
          "title": "Source Observation Id",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "product_id",
        "source_pid",
        "source_observation_id"
      ],
      "title": "SkuEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "dataset_revision": {
      "title": "Dataset Revision",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "rules_version": {
      "title": "Rules Version",
      "type": "string"
    },
    "namespace": {
      "title": "Namespace",
      "type": "string"
    },
    "sku_count": {
      "minimum": 0,
      "title": "Sku Count",
      "type": "integer"
    },
    "sorted_skus": {
      "items": {
        "$ref": "#/$defs/SkuEntry"
      },
      "title": "Sorted Skus",
      "type": "array"
    },
    "canonical_business_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Business Digest",
      "type": "string"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Sha256"
    }
  },
  "required": [
    "dataset_revision",
    "source_sha256",
    "rules_version",
    "namespace",
    "sku_count",
    "sorted_skus",
    "canonical_business_digest"
  ],
  "title": "SkuManifest",
  "type": "object"
}
