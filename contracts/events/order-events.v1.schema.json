{
  "definitions": {
    "EventMetadata": {
      "additionalProperties": true,
      "properties": {
        "dataset_revision": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[!-~]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Revision"
        },
        "synthetic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic"
        },
        "scenario_source": {
          "anyOf": [
            {
              "enum": [
                "simulation",
                "benchmark"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Source"
        },
        "original_event_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Event Id"
        }
      },
      "title": "EventMetadata",
      "type": "object"
    },
    "JsonValue": {},
    "OrderEvent": {
      "properties": {
        "order_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Order Id",
          "type": "string"
        },
        "order_status": {
          "enum": [
            "PENDING",
            "CONFIRMED",
            "CANCELLED"
          ],
          "title": "Order Status",
          "type": "string"
        },
        "total_amount_minor": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Total Amount Minor",
          "type": "integer"
        },
        "currency": {
          "const": "INR",
          "title": "Currency",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$",
          "title": "Created At",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "title": "User Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "quote_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Quote Id",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[!-~]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        }
      },
      "required": [
        "order_id",
        "order_status",
        "total_amount_minor",
        "currency",
        "created_at",
        "user_id",
        "session_id",
        "quote_id",
        "failure_code"
      ],
      "title": "OrderEvent",
      "type": "object"
    },
    "OrderConfirmed": {
      "properties": {
        "order_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Order Id",
          "type": "string"
        },
        "order_status": {
          "enum": [
            "PENDING",
