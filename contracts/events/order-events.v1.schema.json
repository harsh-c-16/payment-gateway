          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Total Amount Minor",
          "type": "integer"
        },
        "currency": {
          "const": "INR",
          "title": "Currency",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$",
          "title": "Created At",
          "type": "string"
        },
        "user_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "title": "User Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "quote_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Quote Id",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[!-~]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        },
        "reservation_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Reservation Id",
          "type": "string"
        },
        "payment_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Payment Id",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "order_status",
        "total_amount_minor",
        "currency",
        "created_at",
        "user_id",
        "session_id",
        "quote_id",
        "failure_code",
        "reservation_id",
        "payment_id"
      ],
      "title": "OrderConfirmed",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "event_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "ORDER_CREATED",
        "ORDER_CONFIRMED",
        "ORDER_CANCELLED"
      ]
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_time": {
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "title": "Event Time",
      "type": "string"
    },
    "produced_at": {
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "title": "Produced At",
      "type": "string"
    },
    "namespace": {
      "maxLength": 62,
      "pattern": "^(dev|(?:bench|replay)-[a-z0-9-]{1,54})$",
      "title": "Namespace",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[!-~]+$",
      "title": "Run Id",
      "type": "string"
    },
    "source_service": {
      "enum": [
        "conversation",
        "catalog",
        "orders",
        "inventory",
        "payments",
        "benchmark"
      ],
      "title": "Source Service",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Id"
    },
    "user_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "User Id"
    },
    "aggregate_type": {
      "enum": [
        "session",
        "search",
        "order",
        "sku",
        "payment_attempt"
      ],
      "title": "Aggregate Type",
      "type": "string"
    },
    "aggregate_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[!-~]+$",
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_version": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Aggregate Version",
      "type": "integer"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/definitions/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "metadata": {
      "$ref": "#/definitions/EventMetadata"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "event_time",
    "produced_at",
    "namespace",
    "run_id",
    "source_service",
    "correlation_id",
    "session_id",
    "user_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "payload",
    "metadata"
  ],
  "title": "EventEnvelope",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "event_type": {
          "const": "ORDER_CREATED"
        },
        "payload": {
          "allOf": [
            {
              "$ref": "#/definitions/OrderEvent"
            },
            {
              "properties": {
                "order_status": {
                  "const": "PENDING"
                }
              }
            }
          ]
        },
        "source_service": {
          "enum": [
            "orders",
            "benchmark"
          ]
        },
        "aggregate_type": {
          "const": "order"
        },
        "metadata": {
          "properties": {
            "dataset_revision": {
              "type": "string"
            },
            "synthetic": {
              "const": true
            },
            "scenario_source": {
              "enum": [
                "simulation",
                "benchmark"
              ]
            }
          },
          "required": [
            "dataset_revision",
            "synthetic",
            "scenario_source"
          ]
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "ORDER_CONFIRMED"
        },
        "payload": {
          "allOf": [
            {
              "$ref": "#/definitions/OrderConfirmed"
            },
            {
              "properties": {
                "order_status": {
                  "const": "CONFIRMED"
                }
              }
            }
          ]
        },
        "source_service": {
          "enum": [
            "orders",
            "benchmark"
          ]
        },
        "aggregate_type": {
          "const": "order"
        },
        "metadata": {
          "properties": {
            "dataset_revision": {
              "type": "string"
            },
            "synthetic": {
              "const": true
            },
            "scenario_source": {
              "enum": [
                "simulation",
                "benchmark"
              ]
            }
          },
          "required": [
            "dataset_revision",
            "synthetic",
            "scenario_source"
          ]
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "ORDER_CANCELLED"
        },
        "payload": {
          "allOf": [
            {
              "$ref": "#/definitions/OrderEvent"
            },
            {
              "properties": {
                "order_status": {
                  "const": "CANCELLED"
                }
              }
            }
          ]
        },
        "source_service": {
          "enum": [
            "orders",
            "benchmark"
          ]
        },
        "aggregate_type": {
          "const": "order"
        },
        "metadata": {
          "properties": {
            "dataset_revision": {
              "type": "string"
            },
            "synthetic": {
              "const": true
            },
            "scenario_source": {
              "enum": [
                "simulation",
                "benchmark"
              ]
            }
          },
          "required": [
            "dataset_revision",
            "synthetic",
            "scenario_source"
          ]
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source_service": {
            "const": "benchmark"
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "pattern": "^bench-"
          },
          "metadata": {
            "properties": {
              "synthetic": {
                "const": true
              },
              "scenario_source": {
                "const": "benchmark"
              }
            },
            "required": [
              "synthetic",
              "scenario_source"
            ]
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:group3:order-events:v1"
}
