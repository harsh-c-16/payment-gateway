          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[!-~]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Revision"
        },
        "synthetic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic"
        },
        "scenario_source": {
          "anyOf": [
            {
              "enum": [
                "simulation",
                "benchmark"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Source"
        },
        "original_event_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Event Id"
        }
      },
      "title": "EventMetadata",
      "type": "object"
    },
    "JsonValue": {},
